% ===== 页面、字体与标题 =====
\geometry{a4paper,top=3cm,bottom=2.5cm,inner=2.6cm,outer=2.6cm,
  headheight=15pt,headsep=0.47cm,footskip=0.75cm}
% 常用字体不存在时使用 TeX 发行版的 Fandol / TeX Gyre。
\IfFontExistsTF{SimSun}
  {\setCJKmainfont[AutoFakeBold=2]{SimSun}}
  {\setCJKmainfont[BoldFont=FandolSong-Bold,ItalicFont=FandolKai-Regular]{FandolSong-Regular}}
\IfFontExistsTF{SimHei}
  {\setCJKsansfont{SimHei}\newCJKfontfamily\SWUSTHei{SimHei}}
  {\setCJKsansfont{FandolHei-Regular}\newCJKfontfamily\SWUSTHei{FandolHei-Regular}}
\IfFontExistsTF{KaiTi}
  {\newCJKfontfamily\SWUSTKai{KaiTi}}
  {\newCJKfontfamily\SWUSTKai{FandolKai-Regular}}
\IfFontExistsTF{Times New Roman}{\setmainfont{Times New Roman}}{\setmainfont{TeX Gyre Termes}}
\IfFontExistsTF{Arial}{\newfontfamily\EnglishTitleFont{Arial}}{\newfontfamily\EnglishTitleFont{TeX Gyre Heros}}

